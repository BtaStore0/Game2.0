# .gitignore (Unity)

# Unity generated folders
[Ll]ibrary/
[Tt]emp/
Obj/
[Bb]uild/
Builds/
[Bb]uilds*/
Logs/
MemoryCaptures/

# Avoid committing local user settings
UserSettings/

# Asset meta data should be tracked
!Assets/**/*.meta

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs
.vscode/
.vs/
.idea/
*.sln
*.csproj
*.pidb
*.user
*.userprefs
*.unityproj
*.suo
*.tmp
*.booproj
*.svd

# Rider
.idea/
*.sln.iml

# Plugins / packages / build outputs
*.apk
*.aab
*.xcodeproj/
*.xcworkspace/
*.xcuserstate
*.xcuserdatad
*.app
*.ipa
*.dSYM/
.gradle/
gradle-app.setting

# Logs and crash reports
crash.log
sysinfo.txt

# Build generated files
ExportedObj/
*.stackdump
*.pdb
*.mdb

# Package manager / Lock files
PackageCache/
node_modules/

# Others
*.log
*.tmp
*.bak
*.backup

# Temporary generated by Unity
AssetStoreTools*
unitypackage
